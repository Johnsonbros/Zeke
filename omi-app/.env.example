# Public display name returned by health endpoints.
APP_NAME=Zeke Hermes

# Data directory for metadata logs and optional audio capture.
DATA_DIR=/data

# Forwarding mode: none, webhook, or paperclip_cli.
HERMES_FORWARD_MODE=none

# webhook mode: private Hermes/Zeke receiver URL and optional bearer token.
HERMES_FORWARD_URL=
HERMES_FORWARD_TOKEN=

# paperclip_cli mode: create Paperclip issues for Hermes agents.
# If PAPERCLIP_CONTAINER is set, commands run as: docker exec <container> <cli> ...
PAPERCLIP_COMPANY_ID=
PAPERCLIP_ASSIGNEE_AGENT_ID=
PAPERCLIP_STATUS=todo
PAPERCLIP_PRIORITY=medium
PAPERCLIP_CLI=paperclipai
PAPERCLIP_CONTAINER=

# Optional shared token if the Omi configuration can send X-Omi-Token.
OMI_WEBHOOK_TOKEN=

# Required to inspect /events. Leave empty to keep the endpoint inaccessible.
OMI_DEBUG_TOKEN=

# Privacy defaults. Keep false unless debugging deliberately.
STORE_PAYLOADS=false
SAVE_AUDIO=false
